{
  "schema": "gamecli-scenarios/1",
  "templateId": "SvShop",
  "steps": [
    {
      "id": "login-ready",
      "op": "wait",
      "type": "SystemScenarioProbe",
      "member": "LoginReady",
      "equals": "True"
    },
    {
      "id": "enter-game",
      "op": "call",
      "type": "SystemScenarioProbe",
      "member": "EnterGame",
      "equals": "True"
    },
    {
      "id": "home-opened-once",
      "op": "wait",
      "type": "SystemScenarioProbe",
      "member": "HomeOpenings",
      "equals": "1",
      "stableMs": 1200
    },
    {
      "id": "open-shop",
      "op": "call",
      "type": "SystemScenarioProbe",
      "member": "OpenShop",
      "equals": "True"
    },
    {
      "id": "shop-ready",
      "op": "wait",
      "type": "SystemScenarioProbe",
      "member": "ShopReady",
      "equals": "True"
    },
    {
      "id": "daily-tab",
      "op": "call",
      "type": "ShopNavigationBuilder",
      "member": "Inspect",
      "args": [
        3
      ],
      "equals": "DailyTabView"
    },
    {
      "id": "cards",
      "op": "layout",
      "path": "GoodsScroll1/Viewport/ConfiguredItems",
      "name": "ScrollCell(Clone)",
      "count": 12,
      "columns": 6,
      "fullyVisible": true,
      "separate": true,
      "target": "GoodField/BG",
      "uniformScale": true
    },
    {
      "id": "prices",
      "op": "layout",
      "path": "GoodsScroll1/Viewport/ConfiguredItems",
      "name": "ScrollCell(Clone)",
      "count": 12,
      "columns": 6,
      "fullyVisible": true,
      "separate": true,
      "target": "GoodField/BuyBtn/CurrencyBG",
      "inside": "cards"
    },
    {
      "id": "shop-frame",
      "op": "screenshot"
    }
  ]
}
