  m_Text: "\u672C\u516C\u53F8\u79EF\u6781\u5C65\u884C\u300A\u7F51\u7EDC\u6E38\u620F\u884C\u4E1A\u9632\u6C89\u8FF7\u81EA\u5F8B\u516C\u7EA6\u300B\r 
    \u672C\u7F51\u7EDC\u6E38\u620F\u9002\u5408\u5E74\u6EE112\u5468\u5C81\u4EE5\u4E0A\u7684\u7528\u6237\u4F7F\u7528\uFF1B\u4E3A\u4E86\u60A8\u7684\u5065\u5EB7\uFF0C\u8BF7\u5408\u7406\u63A7\u5236\u6E38\u620F\u65F6\u95F4\u3002\r\n\u6279\u51C6\u6587\u53F7\uFF1A\u56FD\u65B0\u51FA\u5BA1[2023]308\u53F7   
    ISBN 978-7-498-09488-7    \u4EAC\u65B0\u51FA\u6587[2022]178\u53F7\r\n\u8457\u4F5C\u6743\u4EBA\uFF1A\u6DF1\u5733\u8FB9\u950B\u79D1\u6280\u6709\u9650\u516C\u53F8  
    \u51FA\u7248\u5355\u4F4D\uFF1A\u5317\u4EAC\u4FA0\u5BA2\u884C\u7F51\u7EDC\u6280\u672F\u6709\u9650\u516C\u53F8   
