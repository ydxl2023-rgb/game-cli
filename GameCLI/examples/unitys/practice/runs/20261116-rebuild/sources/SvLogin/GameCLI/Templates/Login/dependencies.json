{
  "schemaVersion": 1,
  "template": "SvLogin",
  "source": "development",
  "pages": [
    {
      "widget": "UILogin",
      "asset": "Assets/Data/Widgets/SVLogin/SVLogin.prefab"
    },
    {
      "widget": "UIServerSelect",
      "asset": "Assets/Data/Widgets/ServerSelect/ServerSelect.prefab"
    }
  ],
  "inlineCells": [
    "UIServerGroupItem / VMServerGroupItem",
    "UIServerItem / VMServerItem"
  ],
  "syncActions": [
    "SyncFancyGridScrollView",
    "SyncFancyGridClick"
  ],
  "sharedTypes": [
    "RuntimeSystem : XEventModule",
    "SystemActive.type : System.Type",
    "LoginSucceed.pid : int",
    "NoticeSystem",
    "MasterEntity.GetAttr(MasterPropertyDef.PID)",
    "Oathx.HttpProtocol.LoginResponse (pid, loginAt, tmcreate)"
  ],
  "legacyDependency": "LoginEntity.Refresh(LoginResponse) is still present in development. Its original Protocols.cs is archived in reference scope; do not install unrelated protocol types blindly. The local login path does not invoke a network service.",
  "entityInitialization": [
    "LoginEntity",
    "MasterEntity"
  ],
  "configuration": {
    "source": "propCommonText.xlsx",
    "ids": {
      "LOGIN_RECENT_SERVER": 1001,
      "LOGIN_RECOMMENDED_SERVER": 1002,
      "LOGIN_SERVER_RANGE": 1003,
      "LOGIN_LOCAL_SERVER_NAME": 1004,
      "LOGIN_SERVER_NORMAL": 1005,
      "LOGIN_SERVER_BUSY": 1006,
      "LOGIN_SERVER_MAINTENANCE": 1007
    },
    "requires": [
      "Config.Excel generated aliases",
      "Excel.propCommonTextById",
      "Excel.propLanguageById",
      "loaded CommonText and Language tables"
    ]
  },
  "semantics": "Local test server catalog and local LoginSucceed event; no server authentication.",
