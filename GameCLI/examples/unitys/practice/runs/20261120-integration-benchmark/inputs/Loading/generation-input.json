        "scripts": {
          "files": [
            {
              "path": "Assets/Scripts/Systems/Loading/UI/UILoading.cs",
              "sha256": "d70535d9f8ee7add1cc126899cc00a8e993350d771b6daf4dcb916d1a474a959",
              "content": "using Oathx.Widget;\nusing UnityEngine;\n\n/// <summary>\n/// Displays caller-supplied loading progress without performing loading work.\n/// </summary>\n[Config(\"Assets/Data/Widgets/Loading/Loading.prefab\", WidgetLayer.topmost, cacheWidget: false)]\npublic class UILoading : UIWidget<VMLoading>\n{\n    /// <summary>\n    /// Display the normalized progress and its current status message.\n    /// </summary>\n    /// <param name=\"progress\">Progress from zero to one; NaN is treated as zero.</param>\n    /// <param name=\"message\">Status message preceding the percentage.</param>\n    /// <returns>True when the bound view model was updated.</returns>\n    public bool UpdateProgress(float progress, string message = \"Loading...\")\n    {\n        if (!vm)\n            return false;\n\n        progress = float.IsNaN(progress) ? 0f : Mathf.Clamp01(progress);\n        vm.Rate = $\"{message ?? string.Empty}({Mathf.RoundToInt(progress * 100f)}%)\";\n        return true;\n    }\n\n    /// <summary>\n    /// Update the additional loading tip.\n    /// </summary>\n    /// <param name=\"text\">Tip to display; null clears the label.</param>\n    /// <returns>True when the bound view model was updated.</returns>\n    public bool SetTip(string text)\n    {\n        if (!vm)\n            return false;\n\n        vm.TipText = text ?? string.Empty;\n        return true;\n    }\n}\n"
            },
            {
              "path": "Assets/Scripts/Systems/Loading/UI/UILoading.cs.meta",
              "sha256": "c167842306fc429d1b822f8beee6c16bc1197ccf1a19dbe964845921b3ab1171",
              "content": "fileFormatVersion: 2\nguid: 246121cfd90811f4898216f0e4fb5ecc\nMonoImporter:\n  externalObjects: {}\n  serializedVersion: 2\n  defaultReferences: []\n  executionOrder: 0\n  icon: {instanceID: 0}\n  userData: \n  assetBundleName: \n  assetBundleVariant: \n"
            },
            {
              "path": "Assets/Scripts/Systems/Loading/UI/VMLoading.cs",
              "sha256": "49a99d1d2a6cf7e185350446797f7e0b0301bdd9f6bdc9a5ad3880281ca28c0b",
              "content": "using Oathx.Widget;\n\n/// <summary>\n/// Binds loading progress and tips to the existing loading prefab.\n/// </summary>\npublic partial class VMLoading : VM\n{\n    /// <summary>\n    /// Loading message and percentage displayed by the Rate label.\n    /// </summary>\n    [Binding(typeof(SyncText))]\n    private string rate;\n\n    /// <summary>\n    /// Additional information displayed by the TipText label.\n    /// </summary>\n    [Binding(typeof(SyncText))]\n    private string tipText;\n}\n"
            },
